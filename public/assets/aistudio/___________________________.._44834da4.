בהתבסס על מסמך הבסיס המורחב ("קונטקט אימפרוביזציה: פילוסופיה אידאית, מיפוי מושגי ומטריצות סנכרון מורחבות") ועל מסמך התכנון הקיים של האפליקציה (Contact Ways), להלן מסמך אפיון תוכן ומשתמש מעודכן (v2.0)[cite: 1, 2].
המסמך מארגן מחדש את צירי הרפלקציה והמשוב באפליקציה, מעדכן את תכני הליבה והפעילויות, ומגדיר את חוויית המשתמש (UX) ומבנה הנתונים הנדרשים.
מסמך אפיון תוכן ומשתמש מעודכן: אפליקציית Contact Ways (גרסה 2.0)
1. חזון המוצר ותפיסת העומק (Product Vision & Core Philosophy)
אפליקציית Contact Ways מחברת בין חקירה סומטית עדינה ונטולת שיפוטיות לבין המשגה מקצועית, פיזיקלית, התנהגותית, רגשית ואתית של עולם הקונטקט אימפרוביזציה (CI)[cite: 1, 2].
עקרון הדואליות של המערכת:
1. מרחב הנוכחות הרכה ("כאן ועכשיו" / מסך הבית): ללא ציונים מספריים, מדליות או דירוגי "הצלחה". המשתמש פוגש את גופו דרך סקרנות ("ניסוח שאלה ברקמות" בהשראת דניאל לפקוף), נוכחות בהווה ("מדיטציה רוקדת" – ננסי סטארק סמית') ואמון בגוף ובאדמה[cite: 1, 2].
2. מרחב הרפלקציה המובנית ("+תעוד" / "יומן תנועה" / "חקירות"): עיבוד לאחר ג'אם, סדנה או מפגש "אחד על אחד". במקום סקאלה פשטנית של "טוב/רע", המערכת מאמצת את מודל הוויסות התלת-קוטבי מתוך המטריצות החדשות: תת-תגובה (Under — חסר/נוקשות/ניתוק) ↔ תגובה אינטגרטיבית (Flow — ויסות מיטבי/הקשבה/סנכרון) ↔ תגובת יתר (Over — עודף/פלישה/הצפה).
2. ארגון מחדש של צירי הרפלקציה והמשוב באפליקציה
המעבר מ-6 צירים כלליים למודל מובנה ומעמיק המבוסס על 5 צירי-על (Macro-Axes) ו-150 פרמטרים אבחוניים (30 פרמטרים לכל ציר), המותאמים לשני מצבי שימוש: מצב רפלקציה מהירה (לאחר ג'אם) ומצב מחקר עומק / מרפאת 1:1 (למתקדמים, מורים ומטפלים)[cite: 1, 2, 8].
מיפוי 5 צירי הרפלקציה המרכזיים:


#
	שם הציר באפליקציה
	מוקד התוכן והתשתית המקצועית
	תת-תגובה (Under)
	אינטגרציה (Flow)
	תגובת יתר (Over)
	1
	מכניקה, פיזיקה ומורפולוגיה
	העברת משקל, נקודת מגע מתגלגלת, יישור שלדי, מומנטום, מסת נוזלים (BMC), גוף-אדמה ובינה חייתית.
	החזקה שרירית, נוקשות, ניתוק מהקרקע, פחד מנפילה או תנועה קישוטית ("רקדנות").
	משקל רספונסיבי, תמיכת שלד (Tensegrity), שימוש בתנע ובכבידה.
	קריסת משקל פתאומית, דחיפה (Pushing), נעילת מפרקים או תנועה פראית.
	2
	מגע, קשב ומיינדפולנס סומטי
	תשומת לב טקטילית, חישה היקפית ("ראייה דרך הגוף"), העור כאיבר חישה, אמפתיה קינסטטית ועדות שקטה.
	קשב מפוזר, מיקוד ראייתי צר, מגע טכני יבש, ביקורת עצמית או נסיגה.
	"ציור" קשב דרך המגע, הפיכות המגע ("לגעת זה להינגע"), נוכחות ברגע.
	הצפה חושית, קשב חודרני, "קריאת יתר" פרנואידית או התמזגות (Enmeshment).
	3
	ויסות התנהגותי ודפוסי תנועה
	איכויות מאמץ וצורה לפי לאבאן (LMA: זרימה, משקל, זמן, מרחב) ושלבי התכווננות בסולם SEAM.
	זרימה כבולה (Bound), רפיון סביל, נסיגה כרונית, קיבעון או חוסר תיאום מקצבי.
	גמישות בין זרימה חופשית לכבולה, עלייה/שקיעה, שיקוף צורני וסנכרון זמן.
	זרימה פרועה, תזזיתיות, פלישה מרחבית, חיקוי מכני או אקרובטיקה מנותקת.
	4
	ויסות רגשי ודינמיקה בינאישית
	אמפתיה קינסטטית, הבחנה בין עצמי לאחר, שבירה ותיקון (Rupture & Repair), מודל APIM וחוסן רגשי.
	ניתוק רגשי, בושה/קפיאה מול טעות, ריצוי (Pleasing) או הימנעות מקרבה.
	"טווח הזהב", עקביות עצמית לצד השפעה הדדית, תיקון רך וחמלה עצמית.
	הצפה רגשית, האשמת הפרטנר, ארוטיזציה מבלבלת או חשיפת יתר מניפולטיבית.
	5
	אתיקה, הסכמה ומארג קהילתי
	הסכמה מפורשת ומתמשכת, היכולת לומר ולקבל "לא", נטרול פערי כוח, מטאפורת "הדלת" ואחריות הדדית.
	הסכמה שבשתיקה, קושי להציב גבול, השלכת אחריות או היררכיה קהילתית.
	"לא" כתנאי ל"כן" מלא, אחריות עצמית + "דאגו לאחרים", כוח כפעולה בתיאום.
	נוקשות משפטית הקוטעת תנועה, שימוש ב"לא" להשפלה, פטרונות או משטור.
	עדכון ממשק המשתמש (UI) בטופס +תעוד: במקום מכוון מספרי קשיח (1–10) שיוצר תחושת "ציון", המחוון הופך לסרגל שיווי משקל דו-כיווני (Balance Slider)[cite: 1, 2]:
* שמאל / מטה: קוטב תת-התגובה (Under)
* מרכז (אזור הזרימה): תגובה אינטגרטיבית (Flow)
* ימין / מעלה: קוטב תגובת היתר (Over) (המערכת שומרת ערך פנימי לציור המכ"ם החזותי, אך מציגה למשתמש תיאור מילולי רך בלבד).
3. עדכון תכנים מרכזיים, פעילויות וכרטיסיות (Content & Activities Upgrade)
תכני האפליקציה (כרטיסיות תרגול, נושאי חקירה וצ'ק-ליסטים) מתעדכנים ומתרחבים כדי לשקף את הלקסיקון הסומטי והמתודולוגיות שבמסמך[cite: 1, 2].
א. פעילויות ותרגולים אינטראקטיביים (Guided Scores & Practices)
לצד תרגול "הריקוד הקטן" הקיים, יתווספו 5 מודולי תרגול אינטראקטיביים (עם טיימרים, הנחיות קוליות/טקסטואליות מדורגות וכפתור הפעלה ישיר מכרטיסיות התרגול)[cite: 1, 2]:
1. הריקוד הקטן (The Small Dance — סטיב פקסטון):
   * מבנה: 4 שלבים (עמידה נינוחה ← הרפיית מאמץ ← התבוננות במיקרו-תנודות מול כוח המשיכה ← הכרת תודה שלדית).
2. צ'ק-ליסט כוונון סנסורי (Tuning In — הכנה לג'אם):
   * מבנה: סריקה מונחית בת 4 דקות לפני כניסה למרחב: חישת הרצפה וכוח המשיכה ← דמיון הגוף כ"מסת נוזלים" (90% מים) ← העור כאיבר חישה פתוח ← פקיחת עיניים לחישה היקפית פנורמית (Soft Focus).
3. תרגול "שני הנהרות" (The Two Rivers Score — מרטין קיו):
   * מבנה: סימולטור והנחיה זוגית לתרגול הסכמה לא-מילולית דרך 3 מצבי זרוע: יד פתוחה ("כן / העמק"), הרמת אמה ("המתן / האט"), וכף יד מושטת ("לא / עצור"). משולב גם ככלי דיווח בטופס הרפלקציה.
4. תרגיל "קילוף התפוז": רגע, סליחה, שלום (זוהר רבינוביץ'):
   * מבנה: תרגול זוגי בן 5 פעימות: קילוף (הסרת מניירות של "רקדנות") ← חישת הפלחים (קריאת טונוס השריר של האחר) ← רגע (המתנה שקטה) ← סליחה (עצירה וויסות בעת חשיפת יתר) ← שלום (חזרה נינוחה למגע).
5. רצף זיקות לאבאן לוויסות רגשי (LMA Emotional Resiliency — צחור ושפיר):
   * מבנה: כרטיסיות התערבות מבוססות מצב רגשי נוכחי (מתוך מסך כאן ועכשיו)[cite: 1, 2]:
      * מרגיש כבד/עצוב? ← הצעת תרגול עלייה וקלילות (Upwards / Rise / Light).
      * מרגיש מוצף/חרד? ← הצעת תרגול שקיעה וכוח / סגירה וישירות (Downwards / Sink או Enclose).
      * מרגיש תקוע/נוקשה? ← הצעת תרגול פתיחה ועקיפות (Side-Open / Spread / Indirect).
6. טיימר ומנחה "מרפאת מחקר גופני 1:1" (Embodied Research Clinic):[cite: 2, 8]
   * מבנה: כלי עבודה ייעודי לסשנים של 20 דקות המנהל אוטומטית את 3 שלבי המודל עם צליל פעמון רך:
      * 5 דק': הגדרת שאלת מחקר אחת והסכמה על גבולות (Contract).
      * 10 דק': חקירה סומטית מונחית קשב.
      * 5 דק': עצירה, אינטגרציה וניסוח תובנת מפתח אחת.
ב. עדכון נושאי החקירה וצ'אט ה-AI (InquiriesView)
מאגר החקירות מתעדכן ל-6 נושאי עומק (התואמים לפילוסופיה ולמחקר העדכני) עם שאלות פתיחה, Flip Flashcards ופרומפטים מותאמים למדריך ה-AI[cite: 1, 2]:
1. הבינה החייתית ושאלה ברקמות (פקסטון ולפקוף).
2. מסת הנוזלים, שלד והברית בין עור למוח (BMC ודין ג'והאן).
3. תיאוריית הקרום המשתנה (קרום העצמי, הקרום הבין-אישי והקרום המטאפיזי – דימוק).
4. סנכרון מוחי, עצבי מראה ואמפתיה קינסטטית (Dual-Brain EEG, גאלזה ודמאסיו).
5. פרדוקס ההסכמה, ידית הדלת ואנשים מקולפים (קיו, בליי ורבינוביץ').
6. הג'אם כדמוקרטיה תנועתית ו"טבעות בעץ" (חנה ארנדט, מלטשת הסלעים והזדקנות).
4. אפיון חוויית המשתמש (UX) וזרימות עבודה מעודכנות
א. מסלול 1: "כאן ועכשיו" (הכנה ונוכחות — לפני הריקוד)
1. בחירת טון נוכחות (5 מצבים): שקט ומכונס / סקרן ופתוח / עדין ושברירי / חי ואנרגטי / מקורקע ויציב.
2. התאמה חכמה של תרגול (חדש): בהתאם לטון שנבחר, המערכת מציעה תרגול מווסת קצר (למשל: כוונון סנסורי או רצף לאבאן).
3. בחירת כרטיסיות סקרנות (5 צירים): המשתמש בוחר 1–2 צירים שמסקרנים אותו היום מתוך 5 צירי-העל המעודכנים, ומאמץ "שאלת מחקר פיזית" (כוונה קרובה)[cite: 1, 2].
ב. מסלול 2: "+תעוד" (רפלקציה — אחרי ג'אם או סדנה)
המשתמש בוחר בין שני מצבי תיעוד בראש המסך:
* מצב 1: רפלקציה מהירה (3 דקות — מומלץ אחרי ג'אם):
   * בחירת מסגרת (ג'אם / סדנה / קליניקה 1:1) ושותף/ה (או סולו).
   * סרגלי שיווי משקל (Under ↔ Flow ↔ Over) עבור 5 צירי-העל[cite: 1, 2].
   * בחירת נקודות מגע אנטומיות (מתוך מפת 10 אזורי הגוף) + מצב גבולות ("שני הנהרות" / "קילוף התפוז")[cite: 1, 2].
   * צ'ק-אין מול הכוונה הקרובה + ניסוח תובנת מפתח אחת[cite: 1, 2].
* מצב 2: אבחון עומק ומחקר (למורים, מטפלים ומרפאת 1:1):[cite: 2, 8]
   * פתיחת אקורדיון של 30 הפרמטרים תחת כל אחד מ-5 הצירים.
   * המשתמש יכול לסמן פרמטרים ספציפיים שבהם חווה Under או Over (לדוגמה: "ויסות טונוס שרירי — Over", "הבחנה בין עצמי לאחר — Flow"), ולקבל מיד שאלות רפלקציה קטליטיות והמלצה לתרגול מתקן מתוך הלקסיקון.
ג. מסלול 3: "יומן תנועה" (ניתוח מגמות לאורך זמן)
* מפת מכ"ם (Radar) מעודכנת: מציגה את האיזון של המשתמש על פני 5 צירי-העל (כאשר הטבעת האמצעית מייצגת את אזור ה-Flow, הטבעת הפנימית Under והחיצונית Over)[cite: 1, 2].
* חישוב דינמי בזמן אמת: גרף המקצב השבועי מתעדכן אוטומטית מתוך תאריכי הרשומות והרגעים התומכים של המשתמש.
* תצוגת פרמטרים חוזרים: זיהוי אוטומטי של 3 הפרמטרים (מתוך ה-150) שהופיעו בתדירות הגבוהה ביותר כאתגר או כעוגן בחודש האחרון.
ד. מסלול 4: מרכז המדריך האינטראקטיבי (ⓘ מדריך חי)
* נגיש מכל מסך דרך הסרגל העליון.
* מחולק ל-4 עדשות סינון: הפילוסופיה והמבנה | 5 הצירים ו-150 הפרמטרים | ספריית התרגולים (Scores) | סטודיו מנהל[cite: 1, 2].
* כולל כפתורי קפיצה חיים (Deep Links) הפותחים מיד את הטיימר הרלוונטי (למשל טיימר 1:1), כרטיסיית התרגול או טופס הרפלקציה.
5. ארכיטקטורת נתונים ועדכוני סכמה (Data Model Updates)
כדי לתמוך באפיון החדש תוך שמירה על תאימות לאחור ועל שליטת מנהל התוכן (Firestore + Local Fallback):
1. ReflectionAxisId (מזהה הצירים המעודכן):
   * מעבר ל-5 מזהים קאנוניים: 'mechanics' | 'perception' | 'behavior' | 'emotion' | 'ethics'.
2. MatrixParameter (ישות חדשה ל-150 הפרמטרים):
   * { id: string, axisId: ReflectionAxisId, index: 1..30, title: LocalizedText, underDesc: LocalizedText, flowDesc: LocalizedText, overDesc: LocalizedText, reflectionPrompt: LocalizedText }.
   * נשמר בקובץ קבוע (matrixData.ts) עם אפשרות להוספת הערות והדגשות מסטודיו מנהל.
3. MovementRecord (רשומת רפלקציה מעודכנת):
   * שמירת ערכי 5 הצירים בסקאלה של -5 (Under) עד +5 (Over), כאשר 0 הוא מרכז ה-Flow[cite: 1, 2].
   * הוספת שדה אופציונלי flaggedParameters: Array<{ paramId: string, state: 'under' | 'flow' | 'over' }> עבור מצב האבחון המעמיק.
   * הרחבת שדה מצב הגבולות לכלול הן את מודל שני הנהרות והן את פעימות קילוף התפוז (רגע / סליחה / שלום)[cite: 1, 2].
4. InteractiveScoreTimer (מנוע טיימרים מובנה):
   * רכיב גלובלי אחד המקבל תצורת שלבים (steps: { title, durationSec, instruction }[]) ומפעיל באותו ממשק נקי את הריקוד הקטן, כוונון סנסורי, רצף לאבאן וסבב 20 דקות של מרפאת 1:1[cite: 1, 2, 8].