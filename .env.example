# Server Configuration
PORT=3000
NODE_ENV=development

# GEMINI_API_KEY: Optional for local fallback, required for live Gemini Somatic Guide & Manager Studio AI ingestion.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Base URL where this application is hosted.
APP_URL="http://localhost:3000"

# Optional Firebase Web Config Overrides (defaults to firebase-applet-config.json if omitted)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

